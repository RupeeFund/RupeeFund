{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "worker-configuration.d.ts", "src/**/*", "astro.config.mjs"],
  "exclude": ["dist", "src/worker"]
}
