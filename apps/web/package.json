{
  "name": "@rupeefund/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./plugin": "./src/plugin.ts",
    "./auth": "./src/auth/emdash.ts",
    "./session-driver": "./src/auth/session-driver.ts"
  },
  "scripts": {
    "dev": "PUBLIC_ALLOW_TEST_SITEKEY=true PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA TURNSTILE_SECRET=1x0000000000000000000000000000000AA TURNSTILE_HOSTNAMES=example.com TURNSTILE_ACTION= astro dev",
    "build": "node scripts/build.mjs",
    "preview": "PUBLIC_ALLOW_TEST_SITEKEY=true PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA astro build --outDir dist-preview && node scripts/seed-local.mjs ../../.wrangler/preview && TURNSTILE_SECRET=1x0000000000000000000000000000000AA node ../../scripts/wrangler-dev.mjs --port 8789 --persist-to ../../.wrangler/preview --var TURNSTILE_HOSTNAMES:example.com --var TURNSTILE_ACTION: --var AUTH_ORIGIN:http://localhost:8789",
    "typecheck": "wrangler types && tsc -b tsconfig.build.json && astro check",
    "test": "vitest run",
    "test:e2e": "playwright test --project live --project live-no-js",
    "brand:sync": "node scripts/brand-sync.mts",
    "db:reset": "node scripts/seed-local.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "live:check": "node scripts/live-check.mts",
    "list:export": "node scripts/list-export.mts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "1.2.0",
    "@portabletext/to-html": "^6.0.0",
    "emdash": "1.2.0",
    "hono": "catalog:",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@cloudflare/workers-types": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rupeefund/auth": "workspace:*",
    "@rupeefund/db": "workspace:*",
    "@rupeefund/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "astro": "^7.3.5",
    "devalue": "5.9.4",
    "jsdom": "catalog:",
    "react": "^19.3.0",
    "satori": "^0.33.5",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.1",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "portless": {
    "name": "rupeefund",
    "script": "dev"
  }
}
