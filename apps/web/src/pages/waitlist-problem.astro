---
import Base from "../layouts/Base.astro";
import { REMOVAL_ADDRESS } from "../lib/launch.ts";
---

<Base>
  <div class="wrap section-y flex flex-1 flex-col justify-center">
    <div>
      <h1 class="page-title text-ink mb-4">That didn’t go through</h1>
      <p class="text-sm text-ink-2 text-pretty mb-2">
        We couldn’t add you to the list. Check the email address and try once more.
      </p>
      <p class="text-sm text-ink-2 text-pretty mb-6">
        If you tried a few times in quick succession, wait a minute before trying again.
      </p>
      <p class="text-xs text-ink-3 text-pretty mb-8">
        Still stuck? Email <a href={`mailto:${REMOVAL_ADDRESS}`} class="inline-link"
          >{REMOVAL_ADDRESS}</a
        > and we’ll add you by hand.
      </p>
      <a href="/subscribe" class="btn btn-primary btn-lg"> Try again </a>
    </div>
  </div>
</Base>
