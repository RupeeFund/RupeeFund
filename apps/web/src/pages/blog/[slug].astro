---
import NotFound from "../../components/NotFound.astro";
import PostArticle from "../../components/site/PostArticle.astro";
import { post, posts } from "../../content/load.ts";
import Base from "../../layouts/Base.astro";
import { SITE_NAME } from "../../lib/seo.ts";

const entry = await post(Astro.params.slug ?? "");
if (!entry) Astro.response.status = 404;
const more = entry ? (await posts()).filter((other) => other.slug !== entry.slug).slice(0, 2) : [];
const route = entry && {
  path: `/blog/${entry.slug}`,
  title: `${entry.title} — ${SITE_NAME}`,
  description: entry.excerpt,
  indexable: true,
};
---

{
  entry && route ? (
    <Base route={route}>
      <div class="wrap section-y">
        <PostArticle post={entry} more={more} />
      </div>
    </Base>
  ) : (
    <NotFound />
  )
}
