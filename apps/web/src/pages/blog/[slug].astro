---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PostArticle from "../../components/site/PostArticle.astro";
import { newestFirst } from "../../build/content.ts";
import { content } from "../../build/published.ts";
import { isListed, SITE_NAME } from "../../lib/seo.ts";

export const getStaticPaths = (async () => {
  const posts = newestFirst(content.posts);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, more: posts.filter((other) => other.slug !== post.slug).slice(0, 2) },
  }));
}) satisfies GetStaticPaths;

const { post, more } = Astro.props;
const route = {
  path: `/blog/${post.slug}`,
  title: `${post.title} — ${SITE_NAME}`,
  description: post.excerpt,
  indexable: isListed("/blog"),
};
---

<Base route={route}>
  <div class="wrap section-y">
    <PostArticle post={post} more={more} />
  </div>
</Base>
