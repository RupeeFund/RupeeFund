---
import Base from "../layouts/Base.astro";
import { SUBSCRIBE_CTA } from "../lib/launch.ts";
---

<Base>
  <div class="wrap section-y flex flex-1 flex-col justify-center">
    <div>
      <p class="eyebrow tabular-nums text-brand-fg mb-2">404</p>
      <h1 class="page-title text-ink mb-4">Page not found</h1>
      <p class="text-sm text-ink-2 text-pretty mb-6">
        That page doesn’t exist. Go back home, or join the mailing list.
      </p>
      <div class="flex flex-col items-start gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary btn-lg"> Back to home </a>
        <a href="/subscribe" class="btn btn-quiet btn-lg">{SUBSCRIBE_CTA}</a>
      </div>
    </div>
  </div>
</Base>
