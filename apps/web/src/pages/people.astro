---
import Base from "../layouts/Base.astro";
import PeopleContent from "@rupeefund/site/PeopleContent.astro";
import { loadContent } from "../build/content.ts";
import { REMOVAL_ADDRESS } from "../lib/launch.ts";

const { content } = await loadContent();

const joinMail = `mailto:${REMOVAL_ADDRESS}?subject=${encodeURIComponent(
  "Joining the community team of The Rupee Fund",
)}`;
---

<Base>
  <div class="wrap section-y">
    <h1 class="page-title text-ink mb-10">People</h1>
    <PeopleContent page={content.peoplePage} people={content.people} joinMail={joinMail} />
  </div>
</Base>
