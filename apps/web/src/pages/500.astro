---
import Base from "../layouts/Base.astro";
import { pageRoute } from "../lib/seo.ts";
---

<Base route={pageRoute("/500", "Something went wrong")}>
  <div class="wrap section-y flex flex-1 flex-col justify-center">
    <div>
      <p class="label-mono mb-3 text-[0.875rem] text-brand-fg tabular-nums">500</p>
      <h1 class="poster-page-title burst-after mb-6 text-ink">Something went wrong</h1>
      <p class="lede mb-8 text-ink-2">We could not load this page. Try again in a minute.</p>
      <a href="/" class="btn btn-primary btn-lg">
        {" "}
        Back to home{" "}
      </a>
    </div>
  </div>
</Base>
