---
import Base from "../layouts/Base.astro";
import FaqList from "@rupeefund/site/FaqList.astro";
import { content } from "../build/published.ts";
import { REMOVAL_ADDRESS } from "../lib/launch.ts";
---

<Base>
  <div class="wrap section-y">
    <h1 class="page-title text-ink mb-10">Frequently asked questions</h1>
    <FaqList faq={content.faq} contactAddress={REMOVAL_ADDRESS} />
  </div>
</Base>
