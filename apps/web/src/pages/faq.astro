---
import FaqList from "../components/site/FaqList.astro";
import { faq } from "../content/load.ts";
import Base from "../layouts/Base.astro";
import { REMOVAL_ADDRESS } from "../components/site/constants.ts";
---

<Base>
  <div class="wrap section-y">
    <h1 class="poster-page-title mb-10 text-ink sm:mb-14">Frequently asked questions</h1>
    <FaqList faq={await faq()} contactAddress={REMOVAL_ADDRESS} />
  </div>
</Base>
