---
import Base from "../layouts/Base.astro";
import { REMOVAL_ADDRESS } from "../lib/launch.ts";
---

<Base>
  <div class="wrap section-y flex flex-1 flex-col justify-center">
    <div>
      <h1 class="page-title text-ink mb-4">You’re on the list</h1>
      <p class="text-sm text-ink-2 text-pretty mb-6">
        One email when we open, so you can set up UPI AutoPay. Monthly updates if you asked for
        them. No payment yet.
      </p>
      <p class="text-xs text-ink-3 text-pretty mb-8">
        Changed your mind? Email <a href={`mailto:${REMOVAL_ADDRESS}`} class="inline-link"
          >{REMOVAL_ADDRESS}</a
        > and we’ll remove you.
      </p>
      <a href="/" class="btn btn-primary btn-lg"> Back to home </a>
    </div>
  </div>
</Base>
