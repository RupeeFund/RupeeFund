---
import Base from "../layouts/Base.astro";
import FaqList from "../components/FaqList.astro";
import Icon from "../components/Icon.astro";
import { SEASONS, SUBSCRIBE_CTA } from "../lib/launch.ts";
import { TAGLINE } from "../lib/seo.ts";
---

<Base>
  <section class="wrap pt-6 pb-[clamp(3rem,8vh,5rem)] sm:pt-[clamp(2.5rem,8vh,5rem)]">
    <div class="grid items-start gap-5 lg:grid-cols-2 lg:grid-rows-[auto_auto_1fr] lg:gap-x-16">
      <h1 class="display text-ink lg:col-start-2 lg:row-start-1">The&nbsp;Rupee&nbsp;Fund</h1>
      <p
        class="section-title heading mb-0 text-ink lg:col-start-1 lg:row-span-3 lg:row-start-1"
        data-tagline
      >
        {TAGLINE}
      </p>
      <p class="lede max-w-[36rem] text-ink-2 lg:col-start-2 lg:row-start-2">
        The&nbsp;Rupee&nbsp;Fund pools your monthly contributions over UPI, from ₹15 a month, and
        you decide which projects get funded.
      </p>
      <div class="sm:mt-3 lg:col-start-2 lg:row-start-3">
        <a href="/subscribe" class="btn btn-primary btn-lg" data-hero-cta>
          <Icon name="bell" size={18} />
          {SUBSCRIBE_CTA}
        </a>
      </div>
    </div>
  </section>

  <section class="wrap section-y grid items-start bg-brand text-ink lg:grid-cols-2 lg:gap-16">
    <h2 class="section-title lg:mb-0">
      Lots of us, a little each month, for great projects from India
    </h2>
    <div class="max-w-[36rem]">
      <p class="lede">
        More than 2&nbsp;crore developers in India use GitHub. If 1&nbsp;in&nbsp;100 of us gives ₹15
        a month, the pool gets more than ₹30&nbsp;lakh every month.
      </p>
      <p class="lede mt-4">Together, we can do great things.</p>
      <p class="mt-4 text-sm">
        Source:{" "}
        <a
          href="https://github.blog/news-insights/octoverse/octoverse-a-new-developer-joins-github-every-second-as-ai-leads-typescript-to-1/"
          target="_blank"
          rel="noopener"
          class="inline-link inline-link-ink">GitHub Octoverse 2025</a
        >
      </p>
    </div>
  </section>

  <section class="wrap section-y bg-paper">
    <div class="grid gap-16 lg:grid-cols-2">
      <div>
        <h2 class="section-title text-ink">How it works</h2>
        <ol class="flex flex-col gap-8">
          <li class="step">
            <div class="step-badge">
              <span class="step-number">1</span>
            </div>
            <div class="pt-0.5">
              <h3 class="step-title">Subscribe</h3>
              <p class="step-body">
                Set up a <strong class="text-ink">monthly</strong> contribution with UPI AutoPay, from
                ₹15 a month. Small, regular contributions from many of us keep the fund steady.
              </p>
            </div>
          </li>
          <li class="step">
            <div class="step-badge">
              <span class="step-number">2</span>
            </div>
            <div class="pt-0.5">
              <h3 class="step-title">Pool funds</h3>
              <p class="step-body">
                Your contributions <strong class="text-ink">pool</strong> through the season. The fund
                runs four cycles a year, following the Indian weather seasons.
              </p>
            </div>
          </li>
          <li class="step">
            <div class="step-badge">
              <span class="step-number">3</span>
            </div>
            <div class="pt-0.5">
              <h3 class="step-title">Vote and nominate</h3>
              <p class="step-body">
                Contribute regularly and you earn a <strong class="text-ink">vote</strong> each season.
                You decide how to split it across three kinds of projects. You may also{" "}
                <strong class="text-ink">nominate</strong> one project or person each season.
              </p>
            </div>
          </li>
          <li class="step">
            <div class="step-badge">
              <span class="step-number">4</span>
            </div>
            <div class="pt-0.5">
              <h3 class="step-title">Disburse</h3>
              <p class="step-body">
                Each season, the pool <strong class="text-ink">goes</strong> to the projects that you
                chose, over UPI. We publish every administrative cost, so you can follow your money all
                the way to a project.
              </p>
            </div>
          </li>
        </ol>
      </div>

      <div class="flex flex-col">
        <h2 class="section-title text-ink">Funding seasons</h2>
        <ul>
          {
            SEASONS.map((s) => (
              <li class="flex items-center gap-4 border-t border-ink/15 py-4">
                <img
                  src={`/seasons/${s.spriteSlug}.svg`}
                  alt=""
                  width="40"
                  height="40"
                  class="h-10 w-10 shrink-0"
                />
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg text-ink">{s.name}</h3>
                  <p class="text-sm text-ink-2">{s.months}</p>
                </div>
                <span
                  class="eyebrow shrink-0 rounded-md px-2 py-0.5 text-white"
                  style={`background-color: ${s.accent}`}
                >
                  {s.duration}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="why-title" class="wrap section-y bg-white">
    <h2 id="why-title" class="sr-only">Why contribute</h2>
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-16">
      <div>
        <h3 class="text-xl text-ink mb-3">Nurture new projects</h3>
        <p class="max-w-[36rem] text-sm text-ink-2 text-pretty">
          Give a new project the start it needs.
        </p>
      </div>
      <div>
        <h3 class="text-xl text-ink mb-3">Encourage growing projects</h3>
        <p class="max-w-[36rem] text-sm text-ink-2 text-pretty">
          Help projects that already have a small community or user base grow further.
        </p>
      </div>
      <div>
        <h3 class="text-xl text-ink mb-3">Sustain well-established projects</h3>
        <p class="max-w-[36rem] text-sm text-ink-2 text-pretty">
          Help the projects that many of us rely on keep going.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section-y bg-paper">
    <h2 class="section-title text-ink">Frequently asked questions</h2>
    <FaqList homeOnly />
  </section>
</Base>
