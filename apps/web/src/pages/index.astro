---
import HomeContent from "../components/site/HomeContent.astro";
import { faq, landingContent } from "../content/load.ts";
import Base from "../layouts/Base.astro";
import { REMOVAL_ADDRESS, SEASONS, SUBSCRIBE_CTA } from "../lib/launch.ts";
import { TAGLINE } from "../lib/seo.ts";

const [home, questions] = await Promise.all([landingContent(), faq()]);
---

<Base>
  <HomeContent
    home={home}
    faq={questions}
    seasons={SEASONS}
    tagline={TAGLINE}
    ctaLabel={SUBSCRIBE_CTA}
    contactAddress={REMOVAL_ADDRESS}
  />
</Base>
