---
import Base from "../layouts/Base.astro";
import HomeContent from "@rupeefund/site/HomeContent.astro";
import { loadContent } from "../build/content.ts";
import { REMOVAL_ADDRESS, SEASONS, SUBSCRIBE_CTA } from "../lib/launch.ts";
import { TAGLINE } from "../lib/seo.ts";

const { content } = await loadContent();
---

<Base>
  <HomeContent
    home={content.home}
    faq={content.faq}
    seasons={SEASONS}
    tagline={TAGLINE}
    ctaLabel={SUBSCRIBE_CTA}
    contactAddress={REMOVAL_ADDRESS}
  />
</Base>
