---
import type { POLICY_SLUGS } from "@rupeefund/content/schema";
import PolicyBody from "@rupeefund/site/PolicyBody.astro";
import Base from "./Base.astro";
import { loadContent } from "../build/content.ts";

interface Props {
  slug: (typeof POLICY_SLUGS)[number];
}

const { content } = await loadContent();
const policy = content.policies.find((entry) => entry.slug === Astro.props.slug)!;
---

<Base>
  <div class="wrap section-y">
    <PolicyBody policy={policy} />
  </div>
</Base>
