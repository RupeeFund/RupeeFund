  "faq": [
    {
      "id": "other-funds",
      "slug": "other-funds",
      "status": "published",
      "data": {
        "id": "01M3YV7ZMV07D9PG69M13VM2J2",
        "slug": "other-funds",
        "status": "published",
        "publishedAt": "2026-10-02T17:40:26.907Z",
        "title": "How is this different from FOSS United grants or FLOSS/fund?",
        "answer": [
          {
            "_type": "block",
            "_key": "kl",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "km",
                "text": "Those are large grant programmes, and each one is separate. ",
                "marks": []
              },
              {
                "_type": "span",
                "_key": "kn",
                "text": "FOSS United grants",
                "marks": ["strong"]
              },
              {
                "_type": "span",
                "_key": "ko",
                "text": " have given more than ₹3.3 crore in total to more than 130 grantees in India. ",
                "marks": []
              },
              {
                "_type": "span",
                "_key": "kp",
                "text": "FLOSS/fund",
                "marks": ["strong"]
              },
              {
                "_type": "span",
                "_key": "kq",
                "text": ", from Zerodha, gives up to US$1 million a year to free and open source projects around the world. The Rupee Fund works differently: volunteers run it, and ",
                "marks": []
              },
              {
                "_type": "span",
                "_key": "kr",
                "text": "many of us each give a little",
                "marks": ["strong"]
              },
              {
                "_type": "span",
                "_key": "ks",
                "text": ".",
                "marks": []
              }
            ]
          }
        ],
        "order": 7,
        "home": true,
        "sources": [
          {
            "title": "FOSS United grants",
            "url": "https://fossunited.org/grants"
          },
          {
            "title": "FOSS United grantees",
