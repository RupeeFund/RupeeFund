          },
          {
            "title": "FLOSS/fund",
            "url": "https://floss.fund"
          }
        ]
      }
    },
    {
      "id": "voting",
      "slug": "voting",
      "status": "published",
      "data": {
        "id": "01M3YV7ZKYTG925HEMTJ0D6EAK",
        "slug": "voting",
        "status": "published",
        "publishedAt": "2026-10-02T17:40:26.878Z",
        "title": "How does voting work?",
        "answer": [
          {
            "_type": "block",
            "_key": "k1d",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "k1e",
                "text": "Each season, contributors nominate projects or people and vote on them. You may make ",
                "marks": []
              },
              {
                "_type": "span",
                "_key": "k1f",
                "text": "one nomination a season",
                "marks": ["strong"]
              },
              {
                "_type": "span",
                "_key": "k1g",
                "text": ", your own or someone else’s, or simply vote.",
                "marks": []
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k1h",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "k1i",
                "text": "You split your vote across the three kinds of projects: ",
                "marks": []
              },
              {
                "_type": "span",
                "_key": "k1j",
                "text": "new",
                "marks": ["em"]
              },
              {
                "_type": "span",
                "_key": "k1k",
                "text": ", ",
                "marks": []
              },
              {
                "_type": "span",
                "_key": "k1l",
                "text": "growing",
                "marks": ["em"]
              },
              {
                "_type": "span",
                "_key": "k1m",
                "text": " and ",
                "marks": []
              },
              {
                "_type": "span",
                "_key": "k1n",
                "text": "well-established",
                "marks": ["em"]
              },
              {
                "_type": "span",
                "_key": "k1o",
                "text": ". We will publish the full voting rules before the first vote.",
                "marks": []
              }
            ]
          }
        ],
        "order": 3,
        "home": true,
        "sources": []
      }
    }
