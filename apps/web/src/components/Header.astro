---
import Icon from "./site/Icon.astro";
import { SUBSCRIBE_CTA } from "../lib/launch.ts";
import { normalizePath } from "../lib/seo.ts";

const path = normalizePath(Astro.url.pathname);

const links = [
  { href: "/faq", label: "FAQ" },
  { href: "/people", label: "People" },
];

const onForm = path === "/subscribe";
const heroShowsCta = path === "/";
---

<header
  class="sticky top-0 z-50 border-b border-ink/10 bg-paper/85 backdrop-blur-md backdrop-saturate-150"
>
  <div class="wrap py-3">
    <div class="flex justify-between items-center">
      <a
        href="/"
        class="flex items-center gap-2 min-h-11 rounded-sm"
        aria-label="The Rupee Fund — home"
      >
        <img src="/logo.svg" alt="The Rupee Fund" width="83" height="36" class="h-9 w-auto" />
      </a>
      <nav class="hidden md:flex gap-5 items-center min-h-12" aria-label="Primary">
        {
          links.map((l) => (
            <a href={l.href} aria-current={path === l.href ? "page" : undefined} class="nav-link">
              {l.label}
            </a>
          ))
        }
        {
          onForm ? (
            <a href="/" class="btn btn-quiet" aria-label="Back to home">
              <Icon name="arrow-left" size={18} />
              Back
            </a>
          ) : (
            <a
              href="/subscribe"
              class="btn btn-quiet btn-collapsible"
              data-header-cta
              data-compact={heroShowsCta ? "" : undefined}
            >
              <Icon name="bell" size={18} />
              <span class="btn-label">
                <span>{SUBSCRIBE_CTA}</span>
              </span>
            </a>
          )
        }
      </nav>
      <details class="group md:hidden" data-menu>
        <summary
          class="list-none inline-flex items-center justify-center w-11 h-11 -mr-2 rounded-lg text-ink cursor-pointer transition duration-150 ease-out [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="menu" class="group-open:hidden" />
          <Icon name="close" class="hidden group-open:block" />
        </summary>
        <nav
          class="wrap absolute inset-x-0 top-full z-50 flex flex-col items-start gap-1 border-b border-ink/10 bg-white py-3 shadow-card"
          aria-label="Mobile"
        >
          {
            links.map((l) => (
              <a
                href={l.href}
                aria-current={path === l.href ? "page" : undefined}
                class="nav-link -mx-1"
              >
                {l.label}
              </a>
            ))
          }
          {
            onForm ? (
              <a href="/" class="btn btn-quiet btn-block btn-on-white" aria-label="Back to home">
                <Icon name="arrow-left" size={18} />
                Back
              </a>
            ) : (
              <a href="/subscribe" class="btn btn-quiet btn-block btn-on-white">
                {SUBSCRIBE_CTA}
              </a>
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  import { initHeaderCta } from "../scripts/header-cta.ts";
  import { initMenus } from "../scripts/menu.ts";
  initMenus();
  initHeaderCta();
</script>
