---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section aria-labelledby="groups-title" class="wrap section-y bg-white pt-0">
  <div class="grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
    <h2 id="groups-title" class="poster-heading text-ink">
      {title}
    </h2>
    <ul class="border-b-[3px] border-ink forced-colors:border-[CanvasText]">
      <slot />
    </ul>
  </div>
</section>
