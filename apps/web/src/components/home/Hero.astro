---
import Icon from "../site/Icon.astro";
import { SUBSCRIBE_CTA, TAGLINE } from "../site/constants.ts";

const NAME = "The Rupee Fund";
const SHAPE = "polygon(0 3px, 100% 0, calc(100% - 4px) 100%, 3px calc(100% - 2px))";
---

<section
  class:list={["wrap pt-6 pb-10", "sm:pt-[clamp(3rem,7vh,4.5rem)] sm:pb-[clamp(3.5rem,9vh,6rem)]"]}
>
  <div class="@container">
    <h1
      class="poster-figure pb-[0.06em] text-[calc(100cqi/(var(--chars)*0.5575))]"
      style={`--chars: ${NAME.length}`}
      set:html={NAME.replaceAll(" ", "&nbsp;")}
    />
  </div>
  <div
    class:list={[
      "mt-5 grid items-start gap-x-14 gap-y-8 sm:mt-12 sm:gap-y-10",
      "lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]",
    ]}
  >
    <p
      class:list={[
        "heading burst-after mb-0 text-ink",
        "text-[clamp(1.5rem,1rem+2.6vw,3.25rem)] leading-[1.05] font-extrabold",
      ]}
      data-tagline
    >
      {TAGLINE}
    </p>
    <div class="sticker px-6 pt-5 pb-6 sm:px-9 sm:pt-8 sm:pb-9" style={`--shape: ${SHAPE}`}>
      <div class="lede text-ink-2">
        <slot />
      </div>
      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 sm:mt-6">
        <a href="/subscribe" class="btn btn-primary btn-lg" data-hero-cta>
          <Icon name="bell" size={18} />
          {SUBSCRIBE_CTA}
        </a>
        <a href="/faq" class="nav-link gap-1.5 text-sm font-semibold">
          Read FAQs <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
