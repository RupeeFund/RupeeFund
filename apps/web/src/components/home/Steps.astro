---
import Icon from "../site/Icon.astro";
import { SEASONS } from "../site/constants.ts";

interface Props {
  title: string;
  seasonsTitle: string;
}

const { title, seasonsTitle } = Astro.props;
const SHAPES = [
  "polygon(0 2px, 100% 0, calc(100% - 3px) 100%, 2px calc(100% - 3px))",
  "polygon(2px 0, calc(100% - 2px) 3px, 100% calc(100% - 2px), 0 100%)",
  "polygon(0 0, calc(100% - 3px) 2px, 100% 100%, 3px calc(100% - 2px))",
  "polygon(3px 3px, 100% 0, calc(100% - 2px) calc(100% - 3px), 0 100%)",
];
---

<div class="bg-paper lg:wrap lg:section-y lg:grid lg:grid-cols-2 lg:gap-16">
  <section aria-labelledby="steps-title" class="wrap section-y lg:p-0">
    <h2 id="steps-title" class="poster-heading text-ink">
      {title}
    </h2>
    <ol class="swipe-row sm:flex sm:flex-col sm:gap-9" tabindex="0" aria-labelledby="steps-title">
      <slot />
    </ol>
  </section>

  <section aria-labelledby="seasons-title" class="wrap section-y pt-0 lg:p-0">
    <h2 id="seasons-title" class="poster-heading text-ink">
      {seasonsTitle}
    </h2>
    <ul class="grid grid-cols-2 gap-x-4 gap-y-5 sm:gap-x-6 sm:gap-y-8">
      {SEASONS.map((s, i) => (
        <li class="sticker flex flex-col gap-3 p-4 sm:gap-4 sm:p-6" style={`--shape: ${SHAPES[i]}`}>
          <div class="flex flex-wrap items-start justify-between gap-2">
            <span class="shrink-0" style={`color: ${s.accent}`}>
              <Icon name={s.icon} size={48} class="size-9 [stroke-width:3.25] sm:size-11" />
            </span>
            <span
              class:list={[
                "label-mono shrink-0 px-1.5 py-0.5 text-[0.6875rem] text-white",
                "sm:px-2 sm:py-1 sm:text-[0.75rem]",
              ]}
              style={`background-color: ${s.accent}`}
            >
              {s.duration}
            </span>
          </div>
          <div>
            <h3
              class:list={[
                "text-[min(1.875rem,calc(100cqi/7.4))] leading-tight font-black",
                "tracking-[-0.03em] whitespace-nowrap text-ink",
              ]}
            >
              {s.name}
            </h3>
            <p class="label-mono mt-1 text-[0.75rem] text-ink-2 sm:text-[0.8125rem]">{s.months}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</div>
