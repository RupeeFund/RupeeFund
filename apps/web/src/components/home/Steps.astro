---
import Icon from "../site/Icon.astro";
import { SEASONS, stickerShape } from "../site/constants.ts";

interface Props {
  title: string;
  seasonsTitle: string;
}

const { title, seasonsTitle } = Astro.props;
const TILTS = ["-rotate-[1.5deg]", "rotate-1", "rotate-[1.2deg]", "-rotate-[0.8deg]"];
---

<div class="overflow-x-clip bg-paper lg:wrap lg:section-y lg:grid lg:grid-cols-2 lg:gap-16">
  <section aria-labelledby="steps-title" class="wrap section-y lg:p-0">
    <h2 id="steps-title" class="poster-heading burst-after text-ink">
      {title}
    </h2>
    <ol class="swipe-row sm:flex sm:flex-col sm:gap-9" tabindex="0" aria-labelledby="steps-title">
      <slot />
    </ol>
  </section>

  <section aria-labelledby="seasons-title" class="wrap section-y pt-0 lg:p-0">
    <h2 id="seasons-title" class="poster-heading burst-after text-ink">
      {seasonsTitle}
    </h2>
    <div class="relative">
      <span
        class="burst -bottom-20 -left-2 z-10 size-14 rotate-[135deg] max-lg:hidden"
        aria-hidden="true"
      />
      <ul
        class:list={[
          "grid grid-cols-2 gap-x-4 gap-y-5 sm:gap-x-6 sm:gap-y-8",
          "lg:auto-rows-[minmax(15rem,auto)]",
        ]}
      >
        {SEASONS.map((s, i) => (
          <li
            class:list={[
              "sticker flex flex-col gap-3 p-4 sm:gap-4 sm:p-6",
              "lg:justify-between lg:even:translate-y-14",
              TILTS[i],
            ]}
            style={`--shape: ${stickerShape(i)}`}
          >
            <div class="flex flex-wrap items-start justify-between gap-2">
              <span class="shrink-0" style={`color: ${s.accent}`}>
                <Icon name={s.icon} size={48} class="size-9 [stroke-width:3.25] sm:size-11" />
              </span>
              <span
                class:list={["label shrink-0 px-1.5 py-0.5 text-xs text-white", "sm:px-2 sm:py-1"]}
                style={`background-color: ${s.accent}`}
              >
                {s.duration}
              </span>
            </div>
            <div>
              <h3
                class:list={[
                  "text-[min(var(--text-lead),calc(100cqi/7.4))] leading-tight font-black",
                  "tracking-[-0.03em] whitespace-nowrap text-ink",
                ]}
              >
                {s.name}
              </h3>
              <p class="label mt-1 text-xs text-ink-2">{s.months}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</div>
