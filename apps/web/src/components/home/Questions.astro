---
import FaqList from "../site/FaqList.astro";
import { faq } from "../../content/load.ts";
import { REMOVAL_ADDRESS } from "../site/constants.ts";

interface Props {
  title: string;
}

const { title } = Astro.props;
const questions = await faq();
---

<section class="wrap section-y overflow-x-clip bg-paper">
  <h2 class="poster-heading burst-after text-ink">{title}</h2>
  <FaqList faq={questions} homeOnly contactAddress={REMOVAL_ADDRESS} />
</section>
