---
import type { Supporters as Figures } from "../../lib/supporters.ts";
import Supporters from "./Supporters.astro";

interface Props {
  title: string;
  supporters: Figures | null;
}

const { title, supporters } = Astro.props;
---

<section class="wrap section-y grid items-start bg-brand text-ink lg:grid-cols-2 lg:gap-16">
  <h2 class="section-title lg:mb-0">{title}</h2>
  <div class="max-w-[36rem]">
    <div class="lede [&>p+p]:mt-4">
      <slot />
    </div>
  </div>
  <Supporters supporters={supporters} />
</section>
