---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<li
  class:list={[
    "grid gap-1.5 border-t-[3px] border-ink py-3.5 forced-colors:border-[CanvasText] sm:py-6",
    "sm:grid-cols-[14rem_1fr] sm:gap-6 lg:grid-cols-1 lg:gap-2",
    "xl:grid-cols-[14rem_1fr] xl:gap-6",
  ]}
>
  <h3 class="text-2xl leading-none font-black tracking-[-0.035em] text-ink sm:text-3xl">{title}</h3>
  <div class="text-sm leading-normal text-pretty text-ink-2 sm:pt-1 sm:leading-relaxed">
    <slot />
  </div>
</li>
