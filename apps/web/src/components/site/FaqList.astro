---
import type { FaqEntry } from "../../content/schema.ts";
import Faq from "./Faq.astro";

interface Props {
  faq: FaqEntry[];
  contactAddress: string;
  homeOnly?: boolean;
}

const { faq, contactAddress, homeOnly = false } = Astro.props;
const entries = faq.filter((entry) => !homeOnly || entry.home);
const PHONE_LIMIT = 4;
---

<div class:list={["grid", homeOnly && "lg:grid-cols-2 lg:gap-x-16"]}>
  {entries.map((entry, i) => (
    <Faq faq={entry} class={homeOnly && i >= PHONE_LIMIT ? "max-sm:hidden" : undefined} />
  ))}

  <div class="faq">
    {homeOnly ? (
      <p class="faq-ghost">
        <a href="/faq" class="inline-link">
          See all questions
        </a>
      </p>
    ) : (
      <p class="faq-ghost">
        <span>More questions?</span>
        <span>
          <a
            href={`mailto:${contactAddress}?subject=Question%20about%20The%20Rupee%20Fund`}
            class="inline-link"
          >
            Email us
          </a>
        </span>
      </p>
    )}
  </div>
</div>
