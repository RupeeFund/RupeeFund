---
import { toInlineHtml } from "../../content/html.ts";
import type { FaqEntry, Landing } from "../../content/schema.ts";
import FaqList from "./FaqList.astro";
import Icon from "./Icon.astro";
import type { Season } from "./constants.ts";

interface Props {
  home: Landing;
  faq: FaqEntry[];
  seasons: readonly Season[];
  tagline: string;
  ctaLabel: string;
  contactAddress: string;
}

const { home, faq, seasons, tagline, ctaLabel, contactAddress } = Astro.props;
---

<section class="wrap pt-6 pb-[clamp(3rem,8vh,5rem)] sm:pt-[clamp(2.5rem,8vh,5rem)]">
  <div class="grid items-start gap-5 lg:grid-cols-2 lg:grid-rows-[auto_auto_1fr] lg:gap-x-16">
    <h1 class="display text-ink lg:col-start-2 lg:row-start-1">The&nbsp;Rupee&nbsp;Fund</h1>
    <p
      class="section-title heading mb-0 text-ink lg:col-start-1 lg:row-span-3 lg:row-start-1"
      data-tagline
    >
      {tagline}
    </p>
    <p class="lede max-w-[36rem] text-ink-2 lg:col-start-2 lg:row-start-2">{home.heroLede}</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 sm:mt-3 lg:col-start-2 lg:row-start-3">
      <a href="/subscribe" class="btn btn-primary btn-lg" data-hero-cta>
        <Icon name="bell" size={18} />
        {ctaLabel}
      </a>
      <a href="/faq" class="nav-link gap-1.5 text-sm font-semibold">
        Read FAQs <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<section class="wrap section-y grid items-start bg-brand text-ink lg:grid-cols-2 lg:gap-16">
  <h2 class="section-title lg:mb-0">{home.pitchTitle}</h2>
  <div class="max-w-[36rem]">
    {
      home.pitchBody.map((block, i) => (
        <p class:list={["lede", i > 0 && "mt-4"]} set:html={toInlineHtml([block])} />
      ))
    }
    <p class="mt-4 text-sm">
      Source:{" "}
      <a
        href={home.pitchSourceUrl}
        target="_blank"
        rel="noopener"
        class="inline-link inline-link-ink">{home.pitchSourceTitle}</a
      >
    </p>
  </div>
</section>

<section class="wrap section-y bg-paper">
  <div class="grid gap-16 lg:grid-cols-2">
    <div>
      <h2 class="section-title text-ink">{home.stepsTitle}</h2>
      <ol class="flex flex-col gap-8">
        {
          home.steps.map((step, i) => (
            <li class="step">
              <div class="step-badge">
                <span class="step-number">{i + 1}</span>
              </div>
              <div class="pt-0.5">
                <h3 class="step-title">{step.title}</h3>
                <p class="step-body" set:html={toInlineHtml(step.body)} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="flex flex-col">
      <h2 class="section-title text-ink">{home.seasonsTitle}</h2>
      <ul>
        {
          seasons.map((s) => (
            <li class="flex items-center gap-4 border-t border-ink/15 py-4">
              <img
                src={`/seasons/${s.spriteSlug}.svg`}
                alt=""
                width="40"
                height="40"
                class="h-10 w-10 shrink-0"
              />
              <div class="min-w-0 flex-1">
                <h3 class="text-lg text-ink">{s.name}</h3>
                <p class="text-sm text-ink-2">{s.months}</p>
              </div>
              <span
                class="eyebrow shrink-0 rounded-md px-2 py-0.5 text-white"
                style={`background-color: ${s.accent}`}
              >
                {s.duration}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section aria-labelledby="why-title" class="wrap section-y bg-white">
  <h2 id="why-title" class="sr-only">Why contribute</h2>
  <div class="grid gap-10 lg:grid-cols-3 lg:gap-16">
    {
      home.why.map((reason) => (
        <div>
          <h3 class="text-xl text-ink mb-3">{reason.title}</h3>
          <p class="max-w-[36rem] text-sm text-ink-2 text-pretty">{reason.body}</p>
        </div>
      ))
    }
  </div>
</section>

<section class="wrap section-y bg-paper">
  <h2 class="section-title text-ink">{home.faqTitle}</h2>
  <FaqList faq={faq} homeOnly contactAddress={contactAddress} />
</section>
