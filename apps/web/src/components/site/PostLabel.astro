---
import type { Post } from "../../content/schema.ts";
import { SEASONS } from "./constants.ts";
import Icon from "./Icon.astro";

interface Props {
  post: Post;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const season = post.season && SEASONS.find((s) => s.name === post.season?.name);
---

<span class="inline-flex flex-wrap items-center gap-x-2.5 gap-y-1">
  <span class="label-mono text-[0.8125rem] text-brand-fg">{post.category}</span>
  {season && post.season && (
    <span class="inline-flex items-center gap-1.5">
      {!compact && (
        <span style={`color: ${season.accent}`}>
          <Icon name={season.icon} size={20} class="size-5 [stroke-width:3]" />
        </span>
      )}
      <span
        class="label-mono px-1.5 py-0.5 text-[0.75rem] text-white"
        style={`background-color: ${season.accent}`}
      >
        {season.name} {post.season.year}
      </span>
    </span>
  )}
</span>
