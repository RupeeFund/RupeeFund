---
import { SUBSCRIBE_CTA } from "./constants.ts";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const SHAPE = "polygon(0 3px, 100% 0, calc(100% - 3px) 100%, 2px calc(100% - 2px))";
---

<aside
  aria-labelledby="signup-title"
  class:list={[
    "sticker p-6 text-ink [--color-card:var(--color-brand)] [--focus:var(--color-ink)] sm:p-8",
    Astro.props.class,
  ]}
  style={`--shape: ${SHAPE}`}
>
  <h2 id="signup-title" class="poster-subheading mb-3">
    Hear when the fund opens
  </h2>
  <p class="text-sm text-pretty mb-6">
    <strong>Nothing to pay today.</strong> We send a welcome email to confirm your sign-up, one
    email when the fund opens, and monthly updates only if you ask for them.
  </p>
  <a href="/subscribe" class="btn btn-primary">
    <Icon name="bell" size={18} />
    {SUBSCRIBE_CTA}
  </a>
</aside>
