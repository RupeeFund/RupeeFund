---
import { grouped, type Supporters } from "../../lib/supporters.ts";
import { SUBSCRIBE_CTA } from "./constants.ts";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
  supporters?: Supporters | null;
}

const { supporters } = Astro.props;
const joined = supporters && `Join ${grouped(supporters.count)} others who have pledged.`;
---

<aside
  aria-labelledby="signup-title"
  class:list={[
    "rounded-2xl bg-brand p-6 text-ink [--focus:var(--color-ink)] sm:p-8",
    Astro.props.class,
  ]}
>
  <h2 id="signup-title" class="text-2xl mb-3">Hear when the fund opens</h2>
  <p class:list={["text-sm text-pretty", joined ? "mb-3" : "mb-6"]}>
    <strong>Nothing to pay today.</strong> We send a welcome email to confirm your sign-up, one email
    when the fund opens, and monthly updates only if you ask for them.
  </p>
  {joined && <p class="text-sm mb-6 font-semibold">{joined}</p>}
  <a href="/subscribe" class="btn btn-primary">
    <Icon name="bell" size={18} />
    {SUBSCRIBE_CTA}
  </a>
</aside>
