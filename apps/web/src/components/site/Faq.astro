---
import type { FaqEntry } from "../../content/schema.ts";
import Icon from "./Icon.astro";
import Prose from "./Prose.astro";

interface Props {
  faq: FaqEntry;
  class?: string;
}

const { faq, class: cls } = Astro.props;
const { question, answer, sources } = faq;
---

<details class:list={["faq group", cls]}>
  <summary class="faq-summary">
    <span>{question}</span>
    <Icon name="plus" size={24} class="faq-plus [stroke-width:3]" />
  </summary>
  <div class="faq-answer">
    <Prose blocks={answer} />
  </div>
  {sources.length > 0 && (
    <p class="faq-sources">
      {sources.length === 1 ? "Source:" : "Sources:"}{" "}
      {sources.map((source, i) => (
        <>
          {i > 0 && ", "}
          <a href={source.url} target="_blank" rel="noopener" class="inline-link">
            {source.title}
          </a>
        </>
      ))}
    </p>
  )}
</details>
