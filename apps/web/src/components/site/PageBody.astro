---
import type { Page } from "../../content/schema.ts";
import Prose from "./Prose.astro";

interface Props {
  page: Page;
}

const { title, effectiveDate, body } = Astro.props.page;
---

<div class="reading">
  <h1 class="page-title text-ink mb-4">{title}</h1>
  {effectiveDate && <p class="text-sm text-ink-2 mb-6">Effective date: {effectiveDate}.</p>}
  <div class="prose"><Prose blocks={body} /></div>
</div>
