---
import type { Editable } from "../../content/entries.ts";
import type { Page } from "../../content/schema.ts";
import Prose from "./Prose.astro";

interface Props {
  page: Editable<Page>;
}

const { title, effectiveDate, body, edit } = Astro.props.page;
---

<div class="reading">
  <h1 class="page-title text-ink mb-4" {...edit?.title}>{title}</h1>
  {
    effectiveDate && (
      <p class="text-sm text-ink-2 mb-6">
        Effective date: <span {...edit?.effective_date}>{effectiveDate}</span>.
      </p>
    )
  }
  <div class="prose"><Prose blocks={body} /></div>
</div>
