---
import type { SeasonIcon } from "./constants.ts";

type IconName =
  | "arrow-left"
  | "bell"
  | "menu"
  | "close"
  | "plus"
  | "users"
  | "chart"
  | SeasonIcon
  | "sprout"
  | "tree-deciduous"
  | "trees";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: cls } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["icon", cls]}
  aria-hidden="true"
>
  {name === "arrow-left" && (
    <Fragment>
      <path d="m12 19-7-7 7-7" />
      <path d="M19 12H5" />
    </Fragment>
  )}
  {name === "bell" && (
    <Fragment>
      <path d="M10.268 21a2 2 0 0 0 3.464 0" />
      <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" />
    </Fragment>
  )}
  {name === "menu" && (
    <Fragment>
      <line x1="4" x2="20" y1="6" y2="6" />
      <line x1="4" x2="20" y1="12" y2="12" />
      <line x1="4" x2="20" y1="18" y2="18" />
    </Fragment>
  )}
  {name === "close" && (
    <Fragment>
      <line x1="6" x2="18" y1="6" y2="18" />
      <line x1="18" x2="6" y1="6" y2="18" />
    </Fragment>
  )}
  {name === "plus" && (
    <Fragment>
      <line x1="12" x2="12" y1="5" y2="19" />
      <line x1="5" x2="19" y1="12" y2="12" />
    </Fragment>
  )}
  {name === "users" && (
    <Fragment>
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <path d="M16 3.128a4 4 0 0 1 0 7.744" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      <circle cx="9" cy="7" r="4" />
    </Fragment>
  )}
  {name === "chart" && (
    <Fragment>
      <rect x="3" y="13" width="4.5" height="8" rx="1" />
      <rect x="9.75" y="4" width="4.5" height="17" rx="1" />
      <rect x="16.5" y="9" width="4.5" height="12" rx="1" />
    </Fragment>
  )}
  {name === "snowflake" && (
    <Fragment>
      <path d="m10 20-1.25-2.5L6 18" />
      <path d="M10 4 8.75 6.5 6 6" />
      <path d="m14 20 1.25-2.5L18 18" />
      <path d="m14 4 1.25 2.5L18 6" />
      <path d="m17 21-3-6h-4" />
      <path d="m17 3-3 6 1.5 3" />
      <path d="M2 12h6.5L10 9" />
      <path d="m20 10-1.5 2 1.5 2" />
      <path d="M22 12h-6.5L14 15" />
      <path d="m4 10 1.5 2L4 14" />
      <path d="m7 21 3-6-1.5-3" />
      <path d="m7 3 3 6h4" />
    </Fragment>
  )}
  {name === "sun" && (
    <Fragment>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2" />
      <path d="M12 20v2" />
      <path d="m4.93 4.93 1.41 1.41" />
      <path d="m17.66 17.66 1.41 1.41" />
      <path d="M2 12h2" />
      <path d="M20 12h2" />
      <path d="m6.34 17.66-1.41 1.41" />
      <path d="m19.07 4.93-1.41 1.41" />
    </Fragment>
  )}
  {name === "cloud-rain" && (
    <Fragment>
      <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
      <path d="M16 14v6" />
      <path d="M8 14v6" />
      <path d="M12 16v6" />
    </Fragment>
  )}
  {name === "leaf" && (
    <Fragment>
      <path
        d="M11 20a10 10 0 0010-10 25.9 25.9 0 00-1.04-7.281 1 1 0 00-1.755-.325
           C15.833 5.5 13 5.5 9.8 6.1A7 7 0 0011 20"
      />
      <path d="M2 21a5 5 0 012.911-4.544C7.613 15.212 8.351 15.24 11 13" />
    </Fragment>
  )}
  {name === "sprout" && (
    <Fragment>
      <path
        d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4
           4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3"
      />
      <path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4" />
      <path d="M5 21h14" />
    </Fragment>
  )}
  {name === "tree-deciduous" && (
    <Fragment>
      <path
        d="M8 19a4 4 0 0 1-2.24-7.32A3.5 3.5 0 0 1 9 6.03V6a3 3 0 1 1 6 0v.04
           a3.5 3.5 0 0 1 3.24 5.65A4 4 0 0 1 16 19Z"
      />
      <path d="M12 19v3" />
    </Fragment>
  )}
  {name === "trees" && (
    <Fragment>
      <path d="M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0Z" />
      <path d="M7 16v6" />
      <path d="M13 19v3" />
      <path
        d="M12 19h8.3a1 1 0 0 0 .7-1.7L18 14h.3a1 1 0 0 0 .7-1.7L16 9h.2
           a1 1 0 0 0 .8-1.7L13 3l-1.4 1.5"
      />
    </Fragment>
  )}
</svg>
