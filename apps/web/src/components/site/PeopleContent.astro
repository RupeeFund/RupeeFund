---
import { toInlineHtml } from "../../content/html.ts";
import type { Content } from "../../content/schema.ts";

interface Props {
  page: Content["peoplePage"];
  people: Content["people"];
  joinMail: string;
}

const { page, people, joinMail } = Astro.props;

const initials = (name: string) =>
  name
    .split(" ")
    .map((part) => part[0])
    .join("")
    .slice(0, 2);

const handle = (member: Content["people"][number]) =>
  member.username ? `@${member.username}` : "FOSS United profile";
---

<section aria-labelledby="community-team" class="mb-14">
  <h2 id="community-team" class="text-2xl text-ink mb-3">{page.teamTitle}</h2>
  <p class="text-sm text-ink-2 text-pretty mb-6">{page.teamIntro}</p>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    {
      people.map((member) => (
        <article class="card flex flex-col items-start gap-4 sm:flex-row">
          {member.photoUrl ? (
            <img
              src={member.photoUrl}
              alt=""
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
              class="h-16 w-16 shrink-0 rounded-full bg-brand-50 object-cover
                outline -outline-offset-1 outline-black/10"
            />
          ) : (
            <div
              class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-brand-50
                text-lg font-semibold text-brand-fg"
              aria-hidden="true"
            >
              {initials(member.name)}
            </div>
          )}
          <div class="min-w-0">
            <h3 class="text-lg text-ink mb-1">{member.name}</h3>
            {member.profileUrl ? (
              <a
                href={member.profileUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-link text-sm"
                aria-label={`${handle(member)} — ${member.name}`}
              >
                {handle(member)}
              </a>
            ) : (
              "Profile link to follow."
            )}
            <p class="mt-3 text-sm text-ink-2 text-pretty">{member.bio ?? "Bio to follow."}</p>
          </div>
        </article>
      ))
    }
    <aside
      aria-labelledby="join-the-team"
      class="flex flex-col items-start gap-4 rounded-2xl border border-dashed border-ink/15 p-6
      sm:flex-row sm:p-8"
    >
      <div
        class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-ink/8 text-2xl
        text-ink-3"
        aria-hidden="true"
      >
        ?
      </div>
      <div class="min-w-0">
        <h3 id="join-the-team" class="text-lg text-ink-3 mb-1">{page.joinTitle}</h3>
        <span class="text-sm text-ink-3">@yourname</span>
        <p class="mt-3 text-sm text-ink-3 text-pretty">{page.joinBody}</p>
        <p class="mt-3 text-sm">
          <a href={joinMail} class="inline-link"> Get in touch </a>
        </p>
      </div>
    </aside>
  </div>
</section>

<section aria-labelledby="foss-united-staff">
  <div>
    <h2 id="foss-united-staff" class="text-2xl text-ink mb-3">{page.foundationTitle}</h2>
    <p class="text-sm text-ink-2 text-pretty" set:html={toInlineHtml(page.foundationBody)} />
  </div>
</section>
