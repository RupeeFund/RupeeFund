---
import { mediaSrcset } from "../../content/media.ts";
import type { Post } from "../../content/schema.ts";
import { dayKey, longDate } from "./dates.ts";
import PostLabel from "./PostLabel.astro";
import Prose from "./Prose.astro";
import SignupCard from "./SignupCard.astro";
import { stickerShape } from "./constants.ts";
import { readingMinutes } from "./reading.ts";

interface Props {
  post: Post;
  more?: Post[];
}

const { post, more = [] } = Astro.props;
const byline = post.authors.length
  ? new Intl.ListFormat("en-GB", { type: "conjunction" }).format(post.authors)
  : "The Rupee Fund volunteers";
const updated =
  post.updatedAt && dayKey(post.updatedAt) > dayKey(post.publishedAt) ? post.updatedAt : undefined;
---

<article class="reading">
  <p class="text-sm mb-8">
    <a href="/blog" class="inline-link">
      Blog
    </a>
  </p>
  <p class="mb-5">
    <PostLabel post={post} />
  </p>
  <h1 class="poster-page-title text-[clamp(2.781rem,2.486rem+1.313vw,3.536rem)] text-ink">
    {post.title}
  </h1>
  <p class="lede mt-5 text-ink-2 text-pretty">{post.excerpt}</p>
  <div
    class:list={[
      "mt-6 mb-8 flex items-center gap-3 border-y-[3px] border-ink py-3.5",
      "forced-colors:border-[CanvasText]",
    ]}
  >
    <span
      aria-hidden="true"
      class="grid size-10 shrink-0 place-items-center bg-brand text-lead font-black text-ink"
    >
      ₹
    </span>
    <div class="text-sm">
      <p class="font-medium text-ink">{byline}</p>
      <p class="text-ink-3 tabular-nums">
        <time datetime={post.publishedAt}>{longDate(post.publishedAt)}</time>
        {updated && (
          <>
            <span aria-hidden="true" class="mx-1">
              ·
            </span>
            Updated <time datetime={updated}>{longDate(updated)}</time>
          </>
        )}
        <span aria-hidden="true" class="mx-1">
          ·
        </span>
        {readingMinutes(post.body)} min read
      </p>
    </div>
  </div>
  {post.image && (
    <figure class="mb-8">
      <img
        src={post.image.src}
        alt={post.image.alt}
        width={post.image.width}
        height={post.image.height}
        class="post-lead"
      />
      {post.image.caption && (
        <figcaption class="mt-2.5 text-sm text-ink-3">{post.image.caption}</figcaption>
      )}
    </figure>
  )}
  <div class="prose">
    <Prose blocks={post.body} />
  </div>
  {more.length > 0 && (
    <nav aria-labelledby="more-title" class="mt-16">
      <h2 id="more-title" class="poster-subheading mb-6 text-ink">
        Keep reading
      </h2>
      <ul class="grid gap-6 sm:grid-cols-2 sm:gap-8">
        {more.map((next, i) => (
          <li class="sticker p-3" style={`--shape: ${stickerShape(i)}`}>
            {next.image && (
              <img
                src={next.image.src}
                alt=""
                srcset={mediaSrcset(next.image.src, next.image.width)}
                sizes="(min-width: 640px) 22rem, calc(100vw - 4rem)"
                width={next.image.width}
                height={next.image.height}
                loading="lazy"
                class="mb-3 aspect-video w-full border-2 border-ink object-cover"
              />
            )}
            <p class="px-1">
              <PostLabel post={next} compact />
            </p>
            <p class="px-1 pt-1 pb-1 text-lead leading-tight font-black tracking-[-0.02em] text-ink">
              <a href={`/blog/${next.slug}`} class="row-link after:absolute after:inset-0">
                {next.title}
              </a>
            </p>
          </li>
        ))}
      </ul>
    </nav>
  )}
  <SignupCard class="mt-12" />
</article>
