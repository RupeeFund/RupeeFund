---
import SocialIcon from "./SocialIcon.astro";
import { REMOVAL_ADDRESS } from "./site/constants.ts";
import { FOOTER_LINKS, linksFor } from "./site/constants.ts";
import type { SocialIconName } from "./SocialIcon.astro";

interface Props {
  blog: boolean;
}

interface Social {
  slug: SocialIconName;
  name: string;
  href: string;
}

const SOCIALS: readonly Social[] = [
  { slug: "x", name: "X", href: "https://x.com/fossunited" },
  { slug: "mastodon", name: "Mastodon", href: "https://mas.to/@fossunited" },
  { slug: "linkedin", name: "LinkedIn", href: "https://in.linkedin.com/company/fossunited" },
  { slug: "youtube", name: "YouTube", href: "https://www.youtube.com/c/fossunited" },
  { slug: "telegram", name: "Telegram", href: "https://t.me/fossunited" },
];

const YEAR = new Intl.DateTimeFormat("en-IN", {
  timeZone: "Asia/Kolkata",
  year: "numeric",
}).format();
---

<footer
  class:list={[
    "border-t-[10px] border-brand bg-ink pt-10 pb-8 text-paper sm:pt-16 sm:pb-10",
    "[--focus:var(--color-white)] forced-colors:border-[CanvasText]",
  ]}
>
  <div class="wrap grid justify-items-center gap-7 text-center sm:gap-10">
    <div class="grid justify-items-center gap-4">
      <a href="/" aria-label="The Rupee Fund — home" class="rounded-sm">
        <img
          src="/logo-dark.svg"
          alt="The Rupee Fund"
          width="184"
          height="80"
          loading="lazy"
          decoding="async"
          class="h-14 w-auto sm:h-20"
        />
      </a>
      <p class="max-w-[36rem] text-sm text-paper text-pretty">
        The&nbsp;Rupee&nbsp;Fund is a community initiative from FOSS United, run by volunteers.
        Together, we back great projects from India.
      </p>
    </div>
    <ul class="label-mono flex flex-wrap justify-center gap-x-2 text-[0.875rem]">
      {linksFor(FOOTER_LINKS, Astro.props.blog).map(({ href, label }) => {
        const external = href.startsWith("https://");
        return (
          <li>
            <a
              href={href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
              class="foot-link"
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
    <div class="grid justify-items-center gap-1">
      <p class="text-xl font-black tracking-[-0.02em]">
        <a href={`mailto:${REMOVAL_ADDRESS}`} aria-label={REMOVAL_ADDRESS} class="foot-link">
          {REMOVAL_ADDRESS.split("@")[0]}
          <wbr />@{REMOVAL_ADDRESS.split("@")[1]}
        </a>
      </p>
      <div class="flex flex-wrap justify-center gap-1 text-xs">
        {SOCIALS.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`FOSS United on ${s.name} (opens in a new tab)`}
            class="foot-link foot-icon link-plain min-w-11 justify-center"
          >
            <SocialIcon name={s.slug} />
          </a>
        ))}
      </div>
    </div>
    <div class="grid w-full justify-items-center gap-3 border-t-2 border-white/25 pt-6 text-xs">
      <div class="flex flex-wrap justify-center gap-x-2">
        <a href="/privacy" class="foot-link">
          Privacy
        </a>
        <a href="/terms" class="foot-link">
          Terms
        </a>
        <a href="/refunds" class="foot-link">
          Refunds
        </a>
        <a href="/code-of-conduct" class="foot-link">
          Code of conduct
        </a>
      </div>
      <p>© {YEAR} The&nbsp;Rupee&nbsp;Fund, by the FOSS United community.</p>
    </div>
  </div>
</footer>
