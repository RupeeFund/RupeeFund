---
import SocialIcon from "./SocialIcon.astro";
import { REMOVAL_ADDRESS } from "../lib/launch.ts";
import { menu } from "../content/load.ts";
import type { SocialIconName } from "./SocialIcon.astro";

interface Social {
  slug: SocialIconName;
  name: string;
  href: string;
}

const SOCIALS: readonly Social[] = [
  { slug: "x", name: "X", href: "https://x.com/fossunited" },
  { slug: "mastodon", name: "Mastodon", href: "https://mas.to/@fossunited" },
  { slug: "linkedin", name: "LinkedIn", href: "https://in.linkedin.com/company/fossunited" },
  { slug: "youtube", name: "YouTube", href: "https://www.youtube.com/c/fossunited" },
  { slug: "telegram", name: "Telegram", href: "https://t.me/fossunited" },
];

const links = await menu("footer");
---

<footer class="bg-ink text-paper [--focus:var(--color-white)] pt-16 pb-10">
  <div class="wrap grid justify-items-center gap-10 text-center">
    <div class="grid justify-items-center gap-4">
      <a href="/" aria-label="The Rupee Fund — home" class="rounded-sm">
        <img
          src="/logo-dark.svg"
          alt="The Rupee Fund"
          width="184"
          height="80"
          loading="lazy"
          decoding="async"
          class="h-20 w-auto"
        />
      </a>
      <p class="max-w-[36rem] text-sm text-paper text-pretty">
        The&nbsp;Rupee&nbsp;Fund is a community initiative from FOSS United, run by volunteers.
        Together, we back great projects from India.
      </p>
    </div>
    <ul class="flex flex-wrap justify-center gap-x-2 text-sm">
      {
        links.map(({ href, label }) => {
          const external = href.startsWith("https://");
          return (
            <li>
              <a
                href={href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class="foot-link"
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
    <div class="grid justify-items-center gap-1">
      <p class="text-lg font-semibold">
        <a href={`mailto:${REMOVAL_ADDRESS}`} class="foot-link"
          >{REMOVAL_ADDRESS.split("@")[0]}<wbr />@{REMOVAL_ADDRESS.split("@")[1]}</a
        >
      </p>
      <div class="flex flex-wrap justify-center gap-1 text-xs">
        {
          SOCIALS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`FOSS United on ${s.name} (opens in a new tab)`}
              class="foot-link foot-icon link-plain min-w-11 justify-center"
            >
              <SocialIcon name={s.slug} />
            </a>
          ))
        }
      </div>
    </div>
    <div class="grid w-full justify-items-center gap-3 border-t border-white/10 pt-6 text-xs">
      <div class="flex flex-wrap justify-center gap-x-2">
        <a href="/privacy" class="foot-link">Privacy</a>
        <a href="/terms" class="foot-link">Terms</a>
        <a href="/refunds" class="foot-link">Refunds</a>
        <a href="/code-of-conduct" class="foot-link">Code of conduct</a>
      </div>
      <p>© 2026 The&nbsp;Rupee&nbsp;Fund, by the FOSS United community.</p>
    </div>
  </div>
</footer>
