---
import Base from "../layouts/Base.astro";
import { SUBSCRIBE_CTA } from "./site/constants.ts";
import { pageRoute } from "../lib/seo.ts";
---

<Base route={pageRoute("/404", "Page not found")}>
  <div class="wrap section-y flex flex-1 flex-col justify-center">
    <div>
      <p class="label mb-3 text-xs text-brand-fg tabular-nums">404</p>
      <h1 class="poster-page-title burst-after mb-6 text-ink">Page not found</h1>
      <p class="lede mb-8 text-ink-2">
        That page doesn’t exist. Go back home, or join the mailing list.
      </p>
      <div class="flex flex-col items-start gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary btn-lg">
          {" "}
          Back to home{" "}
        </a>
        <a href="/subscribe" class="btn btn-quiet btn-lg">
          {SUBSCRIBE_CTA}
        </a>
      </div>
    </div>
  </div>
</Base>
