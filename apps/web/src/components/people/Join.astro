---
import { REMOVAL_ADDRESS } from "../site/constants.ts";

interface Props {
  title: string;
}

const { title } = Astro.props;
const joinMail = `mailto:${REMOVAL_ADDRESS}?subject=${encodeURIComponent(
  "Joining the community team of The Rupee Fund",
)}`;
---

<aside
  aria-labelledby="join-the-team"
  class:list={[
    "flex flex-col items-start gap-5 border-2 border-dashed border-ink/25 p-6",
    "sm:flex-row sm:p-8",
  ]}
>
  <div
    class:list={[
      "flex aspect-square w-1/3 max-w-50 shrink-0 items-center justify-center",
      "bg-ink/6 text-6xl font-black text-ink-3",
      "forced-colors:border-2 forced-colors:border-dashed forced-colors:border-[CanvasText]",
    ]}
    aria-hidden="true"
  >
    ?
  </div>
  <div class="min-w-0 flex-1">
    <h3
      id="join-the-team"
      class="mb-1 text-2xl leading-tight font-black tracking-[-0.03em] text-ink-3"
    >
      {title}
    </h3>
    <span class="text-sm text-ink-3">@yourname</span>
    <div class="mt-3 text-sm text-ink-3 text-pretty">
      <slot />
    </div>
    <p class="mt-3 text-sm">
      <a href={joinMail} class="inline-link">
        {" "}
        Get in touch{" "}
      </a>
    </p>
  </div>
</aside>
