---
import { REMOVAL_ADDRESS } from "../../lib/launch.ts";

interface Props {
  title: string;
}

const { title } = Astro.props;
const joinMail = `mailto:${REMOVAL_ADDRESS}?subject=${encodeURIComponent(
  "Joining the community team of The Rupee Fund",
)}`;
---

<aside
  aria-labelledby="join-the-team"
  class="flex flex-col items-start gap-4 rounded-2xl border border-dashed border-ink/15 p-6
  sm:flex-row sm:p-8"
>
  <div
    class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-ink/8 text-2xl
    text-ink-3"
    aria-hidden="true"
  >
    ?
  </div>
  <div class="min-w-0">
    <h3 id="join-the-team" class="text-lg text-ink-3 mb-1">{title}</h3>
    <span class="text-sm text-ink-3">@yourname</span>
    <div class="mt-3 text-sm text-ink-3 text-pretty"><slot /></div>
    <p class="mt-3 text-sm">
      <a href={joinMail} class="inline-link"> Get in touch </a>
    </p>
  </div>
</aside>
