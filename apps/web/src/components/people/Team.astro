---
import type { Person } from "../../content/schema.ts";
import { people } from "../../content/load.ts";

interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
const members = await people();

const initials = (name: string) =>
  name
    .split(" ")
    .map((part) => part[0])
    .join("")
    .slice(0, 2);

const PHOTO_WIDTH = 200;

const PHONE_PHOTO = 216;

const PHONE_CARD_INSET = 2 * (20 + 24);

const PHONE_PHOTO_SIZE = `calc((100vw - ${PHONE_CARD_INSET}px) / 3)`;

const PHOTO_SIZES = `(min-width: 640px) ${PHOTO_WIDTH}px, ${PHONE_PHOTO_SIZE}`;

const SHAPES = [
  "polygon(0 2px, 100% 0, calc(100% - 3px) 100%, 2px calc(100% - 3px))",
  "polygon(2px 0, calc(100% - 2px) 3px, 100% calc(100% - 2px), 0 100%)",
  "polygon(0 0, calc(100% - 3px) 2px, 100% 100%, 3px calc(100% - 2px))",
  "polygon(3px 3px, 100% 0, calc(100% - 2px) calc(100% - 3px), 0 100%)",
];

const PHOTO = "aspect-square w-1/3 max-w-50 shrink-0 border-[3px] border-ink bg-brand";

const sized = (url: string, pixels = PHOTO_WIDTH * 2) => {
  const photo = new URL(url);
  const param = photo.hostname === "github.com" ? "size" : "s";
  photo.searchParams.delete(param === "size" ? "s" : "size");
  photo.searchParams.set(param, String(pixels));
  return photo.href;
};

const sources = (url: string) =>
  `${sized(url, PHONE_PHOTO)} ${PHONE_PHOTO}w, ${sized(url)} ${PHOTO_WIDTH * 2}w`;

const handle = (member: Person) =>
  member.username ? `@${member.username}` : "FOSS United profile";
---

<section aria-labelledby="community-team" class="mb-16 sm:mb-24">
  <h2 id="community-team" class="poster-subheading mb-3 text-ink">
    {title}
  </h2>
  <p class="poster-intro mb-8 text-ink-2 sm:mb-10">{intro}</p>
  <div class="grid grid-cols-1 gap-6 sm:gap-8 lg:grid-cols-2">
    {members.map((member, i) => (
      <article
        class="sticker flex flex-col items-start gap-5 p-6 sm:flex-row sm:p-8"
        style={`--shape: ${SHAPES[i % SHAPES.length]}`}
      >
        {member.photoUrl ? (
          <img
            src={sized(member.photoUrl)}
            srcset={sources(member.photoUrl)}
            sizes={PHOTO_SIZES}
            alt=""
            width={PHOTO_WIDTH}
            height={PHOTO_WIDTH}
            loading="lazy"
            decoding="async"
            class:list={[PHOTO, "object-cover"]}
          />
        ) : (
          <div
            class:list={[PHOTO, "flex items-center justify-center text-4xl font-black text-ink"]}
            aria-hidden="true"
          >
            {initials(member.name)}
          </div>
        )}
        <div class="min-w-0 flex-1">
          <h3 class="mb-1 text-2xl leading-tight font-black tracking-[-0.03em] text-ink">
            {member.name}
          </h3>
          {member.profileUrl ? (
            <a
              href={member.profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-link bg-origin-content py-1 text-sm"
              aria-label={`${handle(member)} — ${member.name} (opens in a new tab)`}
            >
              {handle(member)}
            </a>
          ) : (
            "Profile link to follow."
          )}
          <p class="mt-3 text-sm text-ink-2 text-pretty">{member.bio ?? "Bio to follow."}</p>
        </div>
      </article>
    ))}
    <slot />
  </div>
</section>
