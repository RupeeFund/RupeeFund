{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "env": ["PUBLIC_*", "TURNSTILE_*", "CMS_CONTENT_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputs": ["dist/**"],
    },
    "typecheck": {
      "outputs": [],
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/package.json",
      ],
      "outputs": ["dist-preview/**"],
    },
  },
}
