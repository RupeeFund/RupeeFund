{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["PUBLIC_*", "TURNSTILE_*", "WORKERS_CI"],
      "inputs": ["$TURBO_DEFAULT$", ".env", "!tests/**", "!playwright.config.ts", "!vitest*.ts"],
      "outputs": ["dist/**"],
    },
    "typecheck": {
      "outputs": ["worker-configuration.d.ts"],
    },
  },
}
