{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rupeefund-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8787 },
  "routes": [{ "pattern": "rupeefund.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "rupeefund-waitlist",
      "database_id": "ba3924ec-33bd-41e6-b1b4-92eb5a58ec61",
      "migrations_dir": "../../packages/db/migrations",
    },
    {
      "binding": "DB",
      "database_name": "rupeefund-content",
      "database_id": "4bd0ce8b-7259-468b-823d-17ec13b8e6b4",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "rupeefund-media" }],
  "images": { "binding": "IMAGES" },
  "vars": {
    "TURNSTILE_HOSTNAMES": "rupeefund.org",
    "TURNSTILE_ACTION": "waitlist_signup",
    "GITHUB_CLIENT_ID": "Iv23lithkWbcVrCtUnYi",
    "AUTH_ORIGIN": "https://rupeefund.org",
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET", "GITHUB_CLIENT_SECRET", "AUTH_SECRET"],
  },
  "ratelimits": [
    {
      "name": "SIGNUP_LIMITER",
      "namespace_id": "7301",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
