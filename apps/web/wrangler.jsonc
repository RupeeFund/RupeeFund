{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rupeefund-web",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "rupeefund.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rupeefund-waitlist",
      "database_id": "ba3924ec-33bd-41e6-b1b4-92eb5a58ec61",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "rupeefund.org",
    "TURNSTILE_ACTION": "waitlist_signup",
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET"],
  },
  "ratelimits": [
    {
      "name": "SIGNUP_LIMITER",
      "namespace_id": "7301",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
