{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rupeefund-admin",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-20",
  "dev": { "port": 8788 },
  "routes": [{ "pattern": "admin.rupeefund.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rupeefund-waitlist",
      "database_id": "ba3924ec-33bd-41e6-b1b4-92eb5a58ec61",
    },
  ],
  "vars": {
    "ACCESS_AUD": "1c73329b2f285fdaba1f31fe1af894b9423b0ed344c66c45aba601c17d404be8",
  },
  "access": {
    "dev": {
      "aud": "1c73329b2f285fdaba1f31fe1af894b9423b0ed344c66c45aba601c17d404be8",
      "identity": { "email": "operator@example.com" },
    },
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
  },
}
