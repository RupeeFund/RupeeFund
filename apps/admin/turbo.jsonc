{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".generated/**"],
    },
    "typecheck": {
      "dependsOn": ["transit", "build"],
    },
    "test": {
      "dependsOn": ["transit", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/wrangler.jsonc"],
    },
    "dev": {
      "dependsOn": ["transit", "build"],
    },
  },
}
