---
import { getCollection } from "astro:content";
import Faq from "./Faq.astro";
import { REMOVAL_ADDRESS } from "../lib/launch.ts";

interface Props {
  homeOnly?: boolean;
}

const { homeOnly = false } = Astro.props;
const entries = (await getCollection("faq", ({ data }) => !homeOnly || data.home)).toSorted(
  (a, b) => a.data.order - b.data.order,
);
---

<div class:list={["grid", homeOnly && "lg:grid-cols-2 lg:gap-x-16"]}>
  {entries.map((entry) => <Faq entry={entry} />)}

  <div class="faq">
    {
      homeOnly ? (
        <p class="faq-ghost">
          <a href="/faq" class="inline-link">
            See all questions
          </a>
        </p>
      ) : (
        <p class="faq-ghost">
          <span>More questions?</span>
          <span>
            <a
              href={`mailto:${REMOVAL_ADDRESS}?subject=Question%20about%20The%20Rupee%20Fund`}
              class="inline-link"
            >
              Email us
            </a>
          </span>
        </p>
      )
    }
  </div>
</div>
