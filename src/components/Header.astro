---
import Icon from "./Icon.astro";
import { normalizePath } from "../lib/seo.ts";

const path = normalizePath(Astro.url.pathname);

const links = [
  { href: "/", label: "Home" },
  { href: "/team", label: "Team" },
];

const subscribeCta = { href: "/subscribe", label: "I am interested" };
---

<header class="bg-white border-b-2 border-ink sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex justify-between items-center">
      <a href="/" class="flex items-center gap-2 min-h-11" aria-label="The Rupee Fund — home">
        <img
          src="/logo.svg"
          alt="The Rupee Fund"
          width="83"
          height="36"
          class="h-9 w-auto"
        />
      </a>
      <nav class="hidden md:flex gap-6 items-center" aria-label="Primary">
        {
          links.map((l) => (
            <a href={l.href} aria-current={path === l.href ? "page" : undefined} class="nav-link">
              {l.label}
            </a>
          ))
        }
        <a href={subscribeCta.href} class="btn btn-primary">{subscribeCta.label}</a>
      </nav>
      <details class="md:hidden">
        <summary
          class="list-none inline-flex items-center justify-center w-11 h-11 -mr-2 rounded-lg text-ink cursor-pointer transition duration-150 ease-out active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg/50 [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="menu" size={22} />
        </summary>
        <nav
          class="absolute inset-x-0 top-full mt-0.5 z-50 flex flex-col gap-1 border-b-2 border-ink bg-white px-4 sm:px-6 py-3 shadow-card"
          aria-label="Mobile"
        >
          {
            links.map((l) => (
              <a href={l.href} aria-current={path === l.href ? "page" : undefined} class="nav-link">
                {l.label}
              </a>
            ))
          }
          <a href={subscribeCta.href} class="btn btn-primary btn-block">{subscribeCta.label}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
