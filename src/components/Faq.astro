---
import { render, type CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

interface Props {
  entry: CollectionEntry<"faq">;
}

const { entry } = Astro.props;
const { question, sources } = entry.data;
const { Content } = await render(entry);
---

<details class="faq group">
  <summary class="faq-summary">
    <span>{question}</span>
    <Icon name="plus" size={20} class="faq-plus" />
  </summary>
  <div class="faq-answer"><Content /></div>
  {
    sources.length > 0 && (
      <p class="faq-sources">
        {sources.length === 1 ? "Source:" : "Sources:"}{" "}
        {sources.map((source, i) => (
          <>
            {i > 0 && ", "}
            <a href={source.url} target="_blank" rel="noopener" class="inline-link">
              {source.title}
            </a>
          </>
        ))}
      </p>
    )
  }
</details>
