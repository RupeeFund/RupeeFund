---
import type { Content } from "@rupeefund/content/schema";
import { SUBSCRIBE_CTA } from "./constants.ts";
import { dayKey, longDate } from "./dates.ts";
import Icon from "./Icon.astro";
import PostLabel from "./PostLabel.astro";
import Prose from "./Prose.astro";
import { readingMinutes } from "./reading.ts";

interface Props {
  post: Content["posts"][number];
  more?: Content["posts"];
}

const { post, more = [] } = Astro.props;
const byline = post.authors.length ? post.authors.join(" and ") : "The Rupee Fund volunteers";
const updated =
  post.updatedAt && dayKey(post.updatedAt) > dayKey(post.publishedAt) ? post.updatedAt : undefined;
---

<article class="reading">
  <p class="text-sm mb-8">
    <a href="/blog" class="inline-link">Blog</a>
  </p>
  <p class="mb-5"><PostLabel post={post} /></p>
  <h1 class="page-title text-ink">{post.title}</h1>
  <p class="lede mt-5 text-ink-2 text-pretty">{post.excerpt}</p>
  <div class="mt-6 mb-8 flex items-center gap-3 border-y border-ink/15 py-3.5">
    <span
      aria-hidden="true"
      class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand font-semibold text-ink"
    >
      ₹
    </span>
    <div class="text-sm">
      <p class="font-medium text-ink">{byline}</p>
      <p class="text-ink-3 tabular-nums">
        <time datetime={post.publishedAt}>{longDate(post.publishedAt)}</time>
        {
          updated && (
            <>
              <span aria-hidden="true" class="mx-1">
                ·
              </span>
              Updated <time datetime={updated}>{longDate(updated)}</time>
            </>
          )
        }
        <span aria-hidden="true" class="mx-1">·</span>
        {readingMinutes(post.body)} min read
      </p>
    </div>
  </div>
  {
    post.image && (
      <figure class="mb-8">
        <img
          src={post.image.src}
          alt={post.image.alt}
          width={post.image.width}
          height={post.image.height}
          class="post-lead"
        />
        {post.image.caption && (
          <figcaption class="mt-2.5 text-sm text-ink-3">{post.image.caption}</figcaption>
        )}
      </figure>
    )
  }
  <div class="prose">
    <Prose blocks={post.body} />
  </div>
  {
    more.length > 0 && (
      <nav aria-labelledby="more-title" class="mt-16">
        <h2 id="more-title" class="eyebrow mb-4 text-ink-3">
          Keep reading
        </h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {more.map((next) => (
            <li class="relative rounded-2xl bg-white p-3">
              {next.image && (
                <img
                  src={next.image.src}
                  alt=""
                  width={next.image.width}
                  height={next.image.height}
                  loading="lazy"
                  class="mb-3 aspect-video w-full rounded-lg object-cover"
                />
              )}
              <p class="px-1">
                <PostLabel post={next} compact />
              </p>
              <p class="px-1 pt-1 pb-1 text-lg font-semibold text-ink">
                <a href={`/blog/${next.slug}`} class="row-link after:absolute after:inset-0">
                  {next.title}
                </a>
              </p>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <aside aria-labelledby="signup-title" class="mt-12 rounded-2xl bg-brand p-6 text-ink sm:p-8">
    <h2 id="signup-title" class="text-xl mb-2">Hear when the fund opens</h2>
    <p class="text-sm mb-6 text-pretty">
      We send one email when the fund opens. We send monthly updates only if you ask for them.
    </p>
    <a href="/subscribe" class="btn btn-primary">
      <Icon name="bell" size={18} />
      {SUBSCRIBE_CTA}
    </a>
  </aside>
</article>
