{
  "name": "rupeefund",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "WRANGLER_SEND_METRICS": "false"
  },
  "onCreateCommand": "sudo corepack enable pnpm",
  "updateContentCommand": "pnpm install --frozen-lockfile",
  "postCreateCommand": "pnpm db:reset",
  "postAttachCommand": "cat .devcontainer/welcome.txt",
  "forwardPorts": [8787, 8788, 8790],
  "portsAttributes": {
    "8787": { "label": "site", "onAutoForward": "openBrowserOnce" },
    "8788": { "label": "admin panel", "onAutoForward": "notify" },
    "8790": { "label": "content manager", "onAutoForward": "notify" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "codespaces": { "openFiles": ["docs/CONTRIBUTING.md"] },
    "vscode": {
      "extensions": [
        "oxc-project.oxc-vscode",
        "astro-build.astro-vscode",
        "editorconfig.editorconfig"
      ]
    }
  }
}
