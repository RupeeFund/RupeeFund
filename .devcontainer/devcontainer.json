{
  "name": "rupeefund",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "WRANGLER_SEND_METRICS": "false"
  },
  "onCreateCommand": "sudo corepack enable pnpm",
  "updateContentCommand": "pnpm install --frozen-lockfile && pnpm --filter @rupeefund/web exec playwright install --with-deps chromium",
  "postCreateCommand": "pnpm db:reset",
  "forwardPorts": [8787, 8788],
  "portsAttributes": {
    "8787": { "label": "site", "onAutoForward": "silent" },
    "8788": { "label": "admin panel", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "codespaces": { "openFiles": ["docs/CONTRIBUTING.md"] },
    "vscode": {
      "extensions": [
        "oxc-project.oxc-vscode",
        "astro-build.astro-vscode",
        "editorconfig.editorconfig"
      ]
    }
  }
}
