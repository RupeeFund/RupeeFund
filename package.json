{
  "name": "rupeefund",
  "version": "0.0.0",
  "private": true,
  "description": "The site of The Rupee Fund, an independent community fund for free and open-source software in India.",
  "keywords": [
    "cloudflare-workers",
    "d1",
    "foss-united"
  ],
  "license": "MIT",
  "author": "FOSS United Community",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "PUBLIC_ALLOW_TEST_SITEKEY=true PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA astro build --outDir dist-preview && TURNSTILE_SECRET=1x0000000000000000000000000000000AA wrangler dev --assets dist-preview --var TURNSTILE_HOSTNAMES:example.com --var TURNSTILE_ACTION:",
    "brand:sync": "node scripts/brand-sync.mts",
    "db:reset": "node scripts/db-reset.mjs",
    "cf-typegen": "wrangler types",
    "typecheck": "pnpm run cf-typegen && tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project live --project live-no-js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --ignore-path .gitignore && prettier --write .",
    "format:check": "oxfmt --ignore-path .gitignore --check && prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && astro check && pnpm run test",
    "list:export": "node scripts/list-export.mts"
  },
  "dependencies": {
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "astro": "^7.3.5",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
