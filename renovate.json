{
  "labels": ["renovate"],
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "major": {
    "dependencyDashboardApproval": true
  },
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 5,
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "customManagers": [
    {
      "description": "The dev container image installs the pnpm of packageManager in package.json.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["npm install -g pnpm@(?<currentValue>\\S+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "EmDash migrates the content database on the first request after a deploy. Ship each bump on purpose, with the steps in section 11.3 of the staff runbook, RupeeFund/ops docs/RUNBOOK.md.",
      "groupName": "EmDash",
      "matchPackageNames": ["emdash", "@emdash-cms/**"],
      "automerge": false
    },
    {
      "description": "astro check needs the TypeScript programmatic API, which tsc 7 dropped. See https://github.com/withastro/roadmap/discussions/1321",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ]
}
