{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "vitest.config.ts",
    "playwright.config.ts",
    "astro.config.mjs"
  ],
  "exclude": ["dist", "src/worker"]
}
